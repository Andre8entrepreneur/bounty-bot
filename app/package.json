{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:env": "tsx scripts/check-env.ts",
    "idl:sync": "tsx scripts/idl-sync.ts",
    "keys:export": "tsx scripts/keys-export.ts",
    "agents:smoke": "tsx scripts/agents-smoke.ts",
    "devnet:setup": "tsx scripts/devnet-setup.ts",
    "e2e:devnet": "tsx scripts/e2e-devnet.ts",
    "e2e:app": "tsx scripts/e2e-app.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:my-agent": "tsx scripts/my-agent-demo.ts",
    "agent:david:start": "npm run agent:david:stop --silent; mkdir -p \"$HOME/my-agent-keys\"; nohup caffeinate -i tsx scripts/my-agent-demo.ts --loop >> \"$HOME/my-agent-keys/david.log\" 2>&1 & echo \"David is running in the background. Logs: npm run agent:david:logs\"",
    "agent:david:stop": "pkill -f 'my-agent-demo.ts --loop' && echo 'David stopped.' || echo 'David was not running.'",
    "agent:david:logs": "tail -n 40 -f \"$HOME/my-agent-keys/david.log\"",
    "keeper:start": "npm run keeper:stop --silent; mkdir -p \"$HOME/my-agent-keys\"; nohup caffeinate -i tsx scripts/keeper.ts >> \"$HOME/my-agent-keys/keeper.log\" 2>&1 & echo \"Keeper is running in the background. Logs: npm run keeper:logs\"",
    "keeper:stop": "pkill -f 'scripts/keeper.ts' && echo 'Keeper stopped.' || echo 'Keeper was not running.'",
    "keeper:logs": "tail -n 40 -f \"$HOME/my-agent-keys/keeper.log\"",
    "my-agent:export-key": "tsx scripts/my-agent-export-key.ts",
    "tusdc:metadata": "tsx scripts/tusdc-metadata.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.1",
    "@anthropic-ai/sdk": "^0.133.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.117.3",
    "@types/jsdom": "^21.1.7",
    "bs58": "^6.0.0",
    "dompurify": "^3.4.16",
    "jsdom": "25.0.0",
    "jszip": "^3.10.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "cssstyle": "4.1.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "bigint-buffer@1.1.5": true,
    "bufferutil@4.1.0": true,
    "fsevents@2.3.3": true,
    "utf-8-validate@6.0.6": true
  }
}
