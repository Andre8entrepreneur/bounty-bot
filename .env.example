# Copy to app/.env.local and fill it in YOUR editor. Never paste values into Claude Code.
# Variable NAMES only in this file — never real values.

# ---------- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
REFEREE_MODEL=claude-sonnet-5-5

SUPABASE_SERVICE_ROLE_KEY=

# Server-side Solana RPC (devnet). Swap for a free Helius devnet URL if the public one rate-limits.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Local machine: folder OUTSIDE the repo holding platform.json, agent-minimal.json, agent-bold.json, agent-luxe.json
KEYS_DIR=/Users/<you>/bounty-keys

# Vercel only (leave empty locally): base58 secret keys, produced by `npm --prefix app run keys:export` (run it yourself)
PLATFORM_SECRET_KEY=
AGENT_MINIMAL_SECRET_KEY=
AGENT_BOLD_SECRET_KEY=
AGENT_LUXE_SECRET_KEY=

# ---------- Scripts only ----------
# Your Phantom devnet address (public) — receives test tUSDC for the demo
DEMO_BUYER_ADDRESS=

# ---------- Public (safe in the browser) ----------
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Program ID, tUSDC mint and treasury are public and live in app/src/config/devnet.json (committed), not here.
