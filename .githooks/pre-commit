#!/usr/bin/env bash
# Pre-commit guard for Bounty Bot.
# Blocks: .env files (except .env.example), Solana keypair files, and anything gitleaks flags.
# Do not edit. Do not bypass with --no-verify.
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)
blocked=""

while IFS= read -r f; do
  [ -z "$f" ] && continue
  base=$(basename "$f")
  case "$base" in
    .env.example) ;;
    .env|.env.*) blocked="${blocked}\n  - ${f} (.env file)" ;;
    *-keypair.json|id.json) blocked="${blocked}\n  - ${f} (keypair file name)" ;;
  esac
  # Solana keypairs are a JSON array of 64 integers: check the staged content, not the working copy.
  if [[ "$f" == *.json ]]; then
    if git show ":$f" 2>/dev/null | tr -d ' \n\r\t' | grep -Eq '^\[([0-9]{1,3},){63}[0-9]{1,3}\]$'; then
      blocked="${blocked}\n  - ${f} (content looks like a Solana keypair)"
    fi
  fi
done <<< "$staged"

if [ -n "$blocked" ]; then
  printf "pre-commit: BLOCKED — secret files are staged:%b\n" "$blocked" >&2
  printf "Unstage them with: git rm --cached <file>\n" >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi

# gitleaks >= 8.19 uses 'gitleaks git'; older versions use 'gitleaks protect'.
if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner
else
  gitleaks protect --staged --redact --no-banner
fi
