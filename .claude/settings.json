{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(~/bounty-keys/**)",
      "Read(~/.config/solana/**)",
      "Read(*-keypair.json)",
      "Read(~/.supabase/**)",
      "Edit(.githooks/**)",
      "Bash(npm --prefix app run keys:export*)",
      "Bash(npm run keys:export*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git config core.hooksPath *)",
      "Bash(solana config set --url mainnet*)",
      "Bash(solana config set -u mainnet*)",
      "Bash(solana config set --url m*)",
      "Bash(solana config set -um*)",
      "Bash(anchor deploy --provider.cluster mainnet*)"
    ],
    "allow": [
      "Bash(anchor build*)",
      "Bash(anchor test*)",
      "Bash(anchor keys *)",
      "Bash(anchor deploy --provider.cluster devnet*)",
      "Bash(solana balance*)",
      "Bash(solana address*)",
      "Bash(solana program show *)",
      "Bash(solana config get*)",
      "Bash(npm --prefix app run *)",
      "Bash(npm --prefix app install*)",
      "Bash(npm --prefix app ci*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(supabase db push*)",
      "Bash(supabase migration *)"
    ]
  }
}
